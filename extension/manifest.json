{
  "manifest_version": 3,
  "name": "Pawchive Image Expander",
  "short_name": "Image Expander",
  "version": "2.0.1",
  "description": "Loads full-resolution images instead of thumbnails on Pawchive (and Kemono) post pages.",
  "icons": {
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pawchive.pw/*",
        "https://*.pawchive.pw/*",
        "https://kemono.cr/*",
        "https://*.kemono.cr/*",
        "https://kemono.su/*",
        "https://*.kemono.su/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pawchive-image-expander@extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
